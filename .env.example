# Copia este archivo como .env y ajusta los valores.

# ---- Organización que atiende el chatbot (multi-organización) ----
# unibague    = Universidad de Ibagué (datos reales)
# demo_torre  = Torre Empresarial Demo (datos ficticios, para mostrar que sirve en cualquier lugar)
CAMPUS_ORG=unibague

# ---- LLM: elige UNA opción ----

# Opción A: Ollama local (gratis, sin internet, lento sin tarjeta gráfica)
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=qwen2.5:7b
LLM_API_KEY=ollama

# Opción B: Groq en la nube (gratis con cuenta, sin tarjeta, responde en segundos)
# Crea la clave en https://console.groq.com/keys y copia el nombre exacto del modelo
# desde la lista de modelos de la consola (cambia con el tiempo).
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=llama-3.3-70b-versatile
# LLM_API_KEY=gsk_tu_clave_aqui

# Fija la hora del "campus" para demos (si no, usa la hora real de Colombia).
# CAMPUS_HORA_SIMULADA=2026-11-18 12:30
